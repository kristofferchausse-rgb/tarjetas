rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // RedConecta MX • Tribu Creativa QRO
    // Production Cloud Firestore Security Rules (LFPDPPP & Security Hardened)
    // FASE UX 03B: RBAC (Agency & Titular) + Secret Isolation
    // ===============================================================

    // Helper functions
    function isValidTheme(theme) {
      return theme in ['ejecutivo', 'negocio', 'personal'];
    }

    function isValidProfile(data) {
      return data.publicId is string && data.publicId.size() > 0 && data.publicId.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.shortName is string && data.shortName.size() > 0 && data.shortName.size() <= 60 &&
             data.role is string && data.role.size() <= 120 &&
             data.company is string && data.company.size() <= 120 &&
             data.phone is string && data.phone.size() <= 30 &&
             data.published is bool &&
             data.statusActive is bool &&
             isValidTheme(data.themeKey) &&
             (!('pin' in data)) &&
             (!('operatorContext' in data));
    }

    function isValidLead(data) {
      return data.publicId is string && data.publicId.size() > 0 && data.publicId.size() <= 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 30 &&
             data.status in ['nuevo', 'contactado', 'reunion', 'cerrado', 'archivado'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 120)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 1000));
    }

    function isValidMeeting(data) {
      return data.publicId is string && data.publicId.size() > 0 && data.publicId.size() <= 100 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.dealTemperature in ['frio', 'tibio', 'caliente'];
    }

    function isAgency(auth) {
      return auth != null && auth.token.role == 'agency';
    }

    function isTitularOf(auth, publicId) {
      return auth != null && auth.token.role == 'titular' && auth.token.publicId == publicId;
    }

    match /profiles/{profileId} {
      // Anyone with the link or QR can view published business cards, agency sees all
      allow read: if resource.data.published == true || isAgency(request.auth);

      // Card creation and updates require agency role and valid schema
      allow create: if isAgency(request.auth) && isValidProfile(request.resource.data);
      allow update: if isAgency(request.auth) && isValidProfile(request.resource.data);
      allow delete: if isAgency(request.auth);
    }

    match /profile_secrets/{profileId} {
      // Solo accesible por backend/Admin SDK
      allow read, write: if false;
    }

    match /activities/{activityId} {
      // Analytics events for card views & vcard downloads
      allow read: if true;
      allow create: if request.resource.data.publicId is string &&
                      request.resource.data.publicId.size() > 0 &&
                      request.resource.data.publicId.size() <= 100;
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      // Visitantes NO pueden leer ni borrar leads.
      // La captura pública se efectúa por servidor (/api/leads/capture).
      allow read: if isAgency(request.auth) || isTitularOf(request.auth, resource.data.publicId);
      allow create: if isAgency(request.auth) || (isTitularOf(request.auth, request.resource.data.publicId) && isValidLead(request.resource.data));
      allow update: if isAgency(request.auth) || (
                      isTitularOf(request.auth, resource.data.publicId) &&
                      isValidLead(request.resource.data) &&
                      request.resource.data.publicId == resource.data.publicId &&
                      request.resource.data.timestamp == resource.data.timestamp
                    );
      allow delete: if isAgency(request.auth) || isTitularOf(request.auth, resource.data.publicId);
    }

    match /meetings/{meetingId} {
      // Meeting intelligence recordings, transcripts, and action items
      allow read, create, update, delete: if isAgency(request.auth) || isTitularOf(request.auth, resource.data.publicId);
    }
  }
}
